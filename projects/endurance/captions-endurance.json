[
  {
    "start": 0.13,
    "end": 1.77,
    "text": "Imagine hearing ice"
  },
  {
    "start": 1.77,
    "end": 2.81,
    "text": "crush your ship while"
  },
  {
    "start": 2.81,
    "end": 3.9899999999999998,
    "text": "you are still standing"
  },
  {
    "start": 3.9899999999999998,
    "end": 4.6899999999999995,
    "text": "on it."
  },
  {
    "start": 4.6899999999999995,
    "end": 5.002727272727272,
    "text": "That"
  },
  {
    "start": 5.002727272727272,
    "end": 6.41,
    "text": "was Shackleton\u2019s"
  },
  {
    "start": 6.41,
    "end": 6.83325,
    "text": "nightmare."
  },
  {
    "start": 7.13,
    "end": 8.61,
    "text": "In nineteen fifteen,"
  },
  {
    "start": 8.61,
    "end": 9.69,
    "text": "Antarctic pack ice"
  },
  {
    "start": 9.69,
    "end": 10.69,
    "text": "seized his ship,"
  },
  {
    "start": 10.69,
    "end": 11.57,
    "text": "Endurance."
  },
  {
    "start": 11.57,
    "end": 12.61,
    "text": "The pressure eventually"
  },
  {
    "start": 12.61,
    "end": 13.39,
    "text": "cracked the wooden"
  },
  {
    "start": 13.39,
    "end": 13.62425,
    "text": "hull."
  },
  {
    "start": 14.13,
    "end": 15.09,
    "text": "The crew abandoned"
  },
  {
    "start": 15.09,
    "end": 16.51,
    "text": "ship and camped on"
  },
  {
    "start": 16.51,
    "end": 17.630000000000003,
    "text": "the ice."
  },
  {
    "start": 17.630000000000003,
    "end": 18.310000000000002,
    "text": "Then the Endurance"
  },
  {
    "start": 18.310000000000002,
    "end": 19.130000000000003,
    "text": "sank,"
  },
  {
    "start": 19.130000000000003,
    "end": 20.05,
    "text": "leaving them with"
  },
  {
    "start": 20.05,
    "end": 21.634333333333334,
    "text": "three small lifeboats."
  },
  {
    "start": 22.13,
    "end": 24.09,
    "text": "Shackleton and five"
  },
  {
    "start": 24.09,
    "end": 25.509999999999998,
    "text": "others took one of"
  },
  {
    "start": 25.509999999999998,
    "end": 26.61,
    "text": "those boats across"
  },
  {
    "start": 26.61,
    "end": 28.369999999999997,
    "text": "eight hundred miles of"
  },
  {
    "start": 28.369999999999997,
    "end": 29.784166666666664,
    "text": "ocean to find help."
  },
  {
    "start": 30.13,
    "end": 31.549999999999997,
    "text": "Every man from the"
  },
  {
    "start": 31.549999999999997,
    "end": 32.99,
    "text": "ship survived."
  },
  {
    "start": 32.99,
    "end": 34.85,
    "text": "But beneath the ice,"
  },
  {
    "start": 34.85,
    "end": 35.73,
    "text": "the wreck stayed"
  },
  {
    "start": 35.73,
    "end": 37.269999999999996,
    "text": "hidden for more than a"
  },
  {
    "start": 37.269999999999996,
    "end": 37.64595833333333,
    "text": "century."
  },
  {
    "start": 38.13,
    "end": 40.150000000000006,
    "text": "In twenty twenty-two,"
  },
  {
    "start": 40.150000000000006,
    "end": 41.330000000000005,
    "text": "an underwater search"
  },
  {
    "start": 41.330000000000005,
    "end": 42.790000000000006,
    "text": "vehicle found it three"
  },
  {
    "start": 42.790000000000006,
    "end": 44.39,
    "text": "thousand meters down."
  },
  {
    "start": 44.39,
    "end": 45.47,
    "text": "On the stern,"
  },
  {
    "start": 45.47,
    "end": 46.33,
    "text": "the name was still"
  },
  {
    "start": 46.33,
    "end": 47.11,
    "text": "there."
  },
  {
    "start": 47.11,
    "end": 47.751625000000004,
    "text": "Endurance."
  }
]